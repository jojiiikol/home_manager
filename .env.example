# Настройки приложения
APP_NAME="Домашний менеджер"
DEBUG=false
# Пустой для локального FastAPI; Compose переопределяет на /api.
ROOT_PATH=

# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Для локального запуска API. В Compose хост и порт переопределяются на db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=home_manager
POSTGRES_USER=home_manager
# Замените перед использованием. .env не должен попадать в Git.
POSTGRES_PASSWORD=change_me_for_local_development

# Порты на хосте; PostgreSQL доступен только через loopback.
POSTGRES_PUBLISHED_PORT=5432
HTTP_PORT=8080
